{
  "expo": {
    "name": "colon-turismo",
    "slug": "colon-turismo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colonturismo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para que puedas escanear los códigos QR ubicados en los diferentes puntos turísticos de Colón.",
        "NSLocationWhenInUseUsageDescription": "Utilizamos tu ubicación para mostrarte los atractivos turísticos, playas y alojamientos más cercanos a ti en tiempo real."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.anonymous.colonturismo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite acceder a tu cámara para escanear los códigos QR de los puntos turísticos de la ciudad."
        }
      ],
      [
        "expo-location",
        {
          "locationPermission": "Permite acceder a tu ubicación para calcular la distancia a los lugares turísticos de Colón."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
